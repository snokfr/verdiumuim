{
	"schemaVersion": 1,
	"id": "verdiumuim",
	"version": "${version}",
	"name": "Verdiumuim",
	"description": "Intel GPU focused rendering optimizations: greedy meshing, single-command MDI batching, async mesh transfers, LOD sinking, and volumetric sun beams.",
	"authors": [
		"snok"
	],
	"contact": {
		"homepage": "https://github.com/snok/verdiumuim",
		"sources": "https://github.com/snok/verdiumuim"
	},
	"license": "CC0-1.0",
	"icon": "assets/verdiumuim/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.snok.Verdiumuim"
		],
		"client": [
			"com.snok.client.VerdiumuimClient"
		],
		"modmenu": [
			"com.snok.client.integration.VerdiumuimModMenu"
		]
	},
	"mixins": [
		"verdiumuim.mixins.json",
		{
			"config": "verdiumuim.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"cloth-config2": "*",
		"modmenu": "*"
	}
}
